title: CUDA Graphs A/B, hybrid 22 layers on GPU  (Qwythos 9B Q4_K_M)
args: -m /home/wrekt/.lmstudio/models/empero-ai/Qwythos-9B-Claude-Mythos-5-1M-GGUF/Qwythos-9B-Claude-Mythos-5-1M-Q4_K_M.gguf -ngl 22 -t 6 -fa 1 -d 0 -p 512 -n 64 -r 3
